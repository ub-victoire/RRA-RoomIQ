# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/RRA_RoomIQ
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Application
SERVER_PORT=8081

# Security
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rra-roomiq/rooms
ROOM_PHOTO_MAX_FILE_SIZE_BYTES=5242880
ROOM_PHOTO_MAX_COUNT=10
ROOM_PHOTO_MAX_FILE_SIZE=5MB
ROOM_PHOTO_MAX_REQUEST_SIZE=6MB

# Email
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Booking/RLC service boundary. Leave identities, keys and category allow-list
# empty until approved and supplied by the deployment secret manager.
BOOKING_DB_URL=
BOOKING_DB_USERNAME=
BOOKING_DB_PASSWORD=
BOOKING_HOST_PORT=8085
BOOKING_SERVICE_TOKEN_ISSUER=
BOOKING_SOURCE_EVIDENCE_SIGNING_KEY_ID=
BOOKING_SOURCE_EVIDENCE_SIGNING_PRIVATE_KEY_LOCATION=
BOOKING_SOURCE_EVIDENCE_CURRENT_KEY_ID=
BOOKING_SOURCE_EVIDENCE_CURRENT_PUBLIC_KEY_LOCATION=
BOOKING_SOURCE_EVIDENCE_PREVIOUS_KEY_ID=
BOOKING_SOURCE_EVIDENCE_PREVIOUS_PUBLIC_KEY_LOCATION=
BOOKING_SOURCE_EVIDENCE_ENABLED=false
BOOKING_SOURCE_EVIDENCE_RELAY_FIXED_DELAY_MS=1000
RLC_SERVICE_URL=http://records-lifecycle-service:8089
RLC_BOOKING_SOURCE_EVIDENCE_ALLOWED_CATEGORIES=
RLC_SOURCE_EVIDENCE_MAX_AGE=PT24H
RLC_BOOKING_HOLD_SERVICE_URL=
RLC_SERVICE_TOKEN_ISSUER=
RLC_SERVICE_TOKEN_KEY_ID=
RLC_SERVICE_TOKEN_PRIVATE_KEY_LOCATION=
RLC_SERVICE_TOKEN_CURRENT_KEY_ID=
RLC_SERVICE_TOKEN_CURRENT_PUBLIC_KEY_LOCATION=
RLC_SERVICE_TOKEN_PREVIOUS_KEY_ID=
RLC_SERVICE_TOKEN_PREVIOUS_PUBLIC_KEY_LOCATION=
RLC_BOOKING_HOLD_DELIVERY_ENABLED=false
RLC_HOST_PORT=8089
RLC_DB_URL=
RLC_DB_USERNAME=
RLC_DB_PASSWORD=
RLC_DB_MIGRATION_USERNAME=
RLC_DB_MIGRATION_PASSWORD=
IDENTITY_SERVICE_URL=
