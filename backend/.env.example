# Shared backend development environment placeholders
# Copy this file to .env and fill in local values.

DB_URL=jdbc:postgresql://localhost:5432/RRA_RoomIQ
DB_USERNAME=postgres
DB_PASSWORD=change-me
SERVER_PORT=8081
ORGANIZATION_SERVICE_PORT=8082
ROOM_SERVICE_PORT=8083
SCHEDULING_SERVICE_PORT=8084
SCHEDULING_SERVICE_PORT=8084
SCHEDULING_SERVICE_PORT=8084

# Generate a random secret with at least 32 bytes for HS256. Never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# Local development may share the credentials above. In deployed environments, set
# distinct service accounts and broker permissions restricted to each service's
# producer routing keys or consumer exchange/queue.
# Booking, Room, and Notification override names are supported:
# BOOKING_RABBITMQ_USERNAME=
# BOOKING_RABBITMQ_PASSWORD=
# ROOM_RABBITMQ_USERNAME=
# ROOM_RABBITMQ_PASSWORD=
# NOTIFICATION_RABBITMQ_USERNAME=
# NOTIFICATION_RABBITMQ_PASSWORD=
NOTIFICATION_REMINDER_DELIVERY_ENABLED=true
NOTIFICATION_REMINDER_FIXED_DELAY_MS=1000

# Notification Service resolves scoped booking-request recipients through Identity.
# Supply a dedicated RS256 key pair via a secret mount; do not put key material here.
ROOMIQ_SERVICE_TOKEN_ISSUER=https://roomiq.local/identity
NOTIFICATION_IDENTITY_RECIPIENT_AUDIENCE=rra-roomiq-identity-recipient-resolution
NOTIFICATION_SERVICE_TOKEN_KEY_ID=notification-current
NOTIFICATION_SERVICE_TOKEN_PRIVATE_KEY_LOCATION=file:/run/secrets/notification-service-private.pem
IDENTITY_NOTIFICATION_RECIPIENT_AUDIENCE=rra-roomiq-identity-recipient-resolution
IDENTITY_NOTIFICATION_SERVICE_CURRENT_KEY_ID=notification-current
IDENTITY_NOTIFICATION_SERVICE_CURRENT_PUBLIC_KEY_LOCATION=file:/run/secrets/notification-service-public.pem
# Optional rotation overlap:
# IDENTITY_NOTIFICATION_SERVICE_PREVIOUS_KEY_ID=notification-previous
# IDENTITY_NOTIFICATION_SERVICE_PREVIOUS_PUBLIC_KEY_LOCATION=file:/run/secrets/notification-service-previous-public.pem

# Booking's transactional outbox relay uses publisher confirms and retains failed events for retry.
BOOKING_EVENT_RELAY_ENABLED=true
BOOKING_EVENT_RELAY_FIXED_DELAY_MS=1000
BOOKING_EVENT_RELAY_CONFIRM_TIMEOUT_MS=3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rra-roomiq/rooms
ROOM_PHOTO_MAX_FILE_SIZE_BYTES=5242880
ROOM_PHOTO_MAX_COUNT=10
ROOM_PHOTO_MAX_FILE_SIZE=5MB
ROOM_PHOTO_MAX_REQUEST_SIZE=6MB

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

FRONTEND_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8080

# Service URLs
IDENTITY_SERVICE_URL=http://localhost:8081
ORGANIZATION_SERVICE_URL=http://localhost:8082
ROOM_SERVICE_URL=http://localhost:8083
SCHEDULING_SERVICE_URL=http://localhost:8084
BOOKING_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
AUDIT_SERVICE_URL=http://localhost:8087
ANALYTICS_SERVICE_URL=http://localhost:8088

# Booking share-link HMAC key ring. Use unique random 32-byte keys encoded as unpadded base64url.
# Example generation: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Keep old versions configured during rotation so existing idempotent retries can reproduce tokens.
# Never commit real key material or log this setting.
BOOKING_SHARE_TOKEN_KEY_RING=v1=<replace-with-random-32-byte-base64url-key>
BOOKING_SHARE_TOKEN_ACTIVE_KEY_VERSION=v1
