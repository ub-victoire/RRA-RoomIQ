# RRA RoomIQ Identity Service
DB_URL=jdbc:postgresql://localhost:5432/roomiq_identity
DB_USERNAME=postgres
DB_PASSWORD=change-me

SERVER_PORT=8081

# Generate a random secret with at least 32 bytes for HS256. Never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

# Verify the Notification Service's RS256 service JWT. Keep the matching private key
# in Notification's secret mount; this service receives only public-key locations.
ROOMIQ_SERVICE_TOKEN_ISSUER=https://roomiq.local/identity
IDENTITY_NOTIFICATION_RECIPIENT_AUDIENCE=rra-roomiq-identity-recipient-resolution
IDENTITY_NOTIFICATION_SERVICE_CURRENT_KEY_ID=notification-current
IDENTITY_NOTIFICATION_SERVICE_CURRENT_PUBLIC_KEY_LOCATION=file:/run/secrets/notification-service-public.pem
# Optional previous public key during a controlled key rotation:
# IDENTITY_NOTIFICATION_SERVICE_PREVIOUS_KEY_ID=notification-previous
# IDENTITY_NOTIFICATION_SERVICE_PREVIOUS_PUBLIC_KEY_LOCATION=file:/run/secrets/notification-service-previous-public.pem
